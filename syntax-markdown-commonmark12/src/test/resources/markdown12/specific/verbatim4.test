.#-----------------------------------------------------
.inputexpect|markdown/1.2
.# The verbatim macro syntax generated for standalone verbatim (see verbatim3.test) is read back as standalone verbatim
.# with the same content (including leading spaces) and parameters.
.#-----------------------------------------------------
before

{{verbatim}}
  indented ```
**not bold**
{{/verbatim}}

{{verbatim class="myclass"}}
with parameters
{{/verbatim}}
.#-----------------------------------------------------
.expect|event/1.0
.#-----------------------------------------------------
beginDocument
beginParagraph
onWord [before]
endParagraph
onVerbatim [
  indented ```
**not bold**
] [false]
onVerbatim [
with parameters
] [false] [[class]=[myclass]]
endDocument
