.#-----------------------------------------------------
.input|markdown/1.2
.# A reference image whose reference isn't defined is parsed as inline verbatim, which is rendered back using the macro
.# syntax with the reserved "verbatim" id so that its content isn't lost.
.#-----------------------------------------------------
before ![image.png][undefined] after
.#-----------------------------------------------------
.expect|event/1.0
.#-----------------------------------------------------
beginDocument
beginParagraph
onWord [before]
onSpace
onVerbatim [![image.png][undefined]] [true]
onSpace
onWord [after]
endParagraph
endDocument
.#-----------------------------------------------------
.expect|markdown/1.2
.#-----------------------------------------------------
before {{verbatim}}![image.png][undefined]{{/verbatim}} after