.#-----------------------------------------------------
.input|xhtml/1.0
.# Groups located in quotation lines (as generated by the XHTML parser): they must be rendered inside the quotation,
.# with a div when they have parameters
.#-----------------------------------------------------
<html><body><blockquote><p>before</p><div class="box"><p>para in quote</p></div></blockquote><blockquote><div><p>para2</p></div></blockquote></body></html>
.#-----------------------------------------------------
.expect|event/1.0
.#-----------------------------------------------------
beginDocument
beginQuotation
beginQuotationLine
onWord [before]
beginGroup [[class]=[box]]
beginParagraph
onWord [para]
onSpace
onWord [in]
onSpace
onWord [quote]
endParagraph
endGroup [[class]=[box]]
endQuotationLine
endQuotation
beginQuotation
beginQuotationLine
beginGroup
beginParagraph
onWord [para2]
endParagraph
endGroup
endQuotationLine
endQuotation
endDocument
.#-----------------------------------------------------
.expect|markdown/1.2
.#-----------------------------------------------------
> before
>
> <div class="box">
>
> para in quote
>
> </div>

> para2
