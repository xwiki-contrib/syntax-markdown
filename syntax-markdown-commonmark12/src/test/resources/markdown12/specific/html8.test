.#-----------------------------------------------------
.input|markdown/1.2
.# Verify that the HTML tags are kept verbatim when parsing HTML
.#-----------------------------------------------------
Hello <a href="x_y" title='*b*'>a\*b \[c]</a>

<div class="x_y">
*a* _b_
</div>

<div>

\*a\* \[\[b]]

</div>

<strong>a\_b</strong> c\*d\*
.#-----------------------------------------------------
.expect|event/1.0
.#-----------------------------------------------------
beginDocument
beginParagraph
onWord [Hello]
onSpace
onMacroInline [html] [clean=false] [<a href="x_y" title='*b*'>a*b [c]</a>]
endParagraph
onMacroStandalone [html] [clean=false] [<div class="x_y">
*a* _b_
</div>]
beginGroup
beginParagraph
onSpecialSymbol [*]
onWord [a]
onSpecialSymbol [*]
onSpace
onSpecialSymbol [[]
onSpecialSymbol [[]
onWord [b]
onSpecialSymbol []]
onSpecialSymbol []]
endParagraph
endGroup
beginParagraph
onMacroInline [html] [clean=false] [<strong>a_b</strong>]
onSpace
onWord [c]
onSpecialSymbol [*]
onWord [d]
onSpecialSymbol [*]
endParagraph
endDocument
