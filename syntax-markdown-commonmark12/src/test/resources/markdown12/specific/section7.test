.#-----------------------------------------------------
.input|markdown/1.2
.# A heading inside a list item located after some text inside a quotation: the section is scoped to the list item
.# and the quotation line containing the list isn't closed by the heading
.#-----------------------------------------------------
> before
>
> - # Title
>   text

after
.#-----------------------------------------------------
.expect|event/1.0
.#-----------------------------------------------------
beginDocument
beginQuotation
beginQuotationLine
onWord [before]
beginList [BULLETED]
beginListItem
beginSection
beginHeader [1, HTitle]
onWord [Title]
endHeader [1, HTitle]
onWord [text]
endSection
endListItem
endList [BULLETED]
endQuotationLine
endQuotation
beginParagraph
onWord [after]
endParagraph
endDocument
