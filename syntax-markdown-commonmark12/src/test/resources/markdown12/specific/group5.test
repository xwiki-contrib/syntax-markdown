.#-----------------------------------------------------
.input|markdown/1.2
.# Only a div alone in its HTML block and balanced at the same nesting level is a Group. All other divs are raw
.# HTML (html macros).
.#-----------------------------------------------------
<div>inline content</div>

<div title="unclosed>

text1

</div>

<div id=a=b>

text2

</div>

<div class="unbalanced">

text3
.#-----------------------------------------------------
.expect|event/1.0
.#-----------------------------------------------------
beginDocument
onMacroStandalone [html] [clean=false] [<div>inline content</div>]
onMacroStandalone [html] [clean=false] [<div title="unclosed>]
beginParagraph
onWord [text1]
endParagraph
onMacroStandalone [html] [clean=false] [</div>]
onMacroStandalone [html] [clean=false] [<div id=a=b>]
beginParagraph
onWord [text2]
endParagraph
onMacroStandalone [html] [clean=false] [</div>]
onMacroStandalone [html] [clean=false] [<div class="unbalanced">]
beginParagraph
onWord [text3]
endParagraph
endDocument
