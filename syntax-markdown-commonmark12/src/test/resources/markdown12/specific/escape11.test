.#-----------------------------------------------------
.input|markdown/1.2
.# The Markdown generated for blocks located after an empty definition description (see escape10.test) is read back
.# with empty definition descriptions, and the blocks outside of the definition list
.#-----------------------------------------------------
t
:   <!-- -->

{{verbatim}}
<b>
{{/verbatim}}

t2
:   <!-- -->

t3
:   d3

after
.#-----------------------------------------------------
.expect|event/1.0
.#-----------------------------------------------------
beginDocument
beginDefinitionList
beginDefinitionTerm
onWord [t]
endDefinitionTerm
beginDefinitionDescription
endDefinitionDescription
endDefinitionList
onVerbatim [
<b>
] [false]
beginDefinitionList
beginDefinitionTerm
onWord [t2]
endDefinitionTerm
beginDefinitionDescription
endDefinitionDescription
beginDefinitionTerm
onWord [t3]
endDefinitionTerm
beginDefinitionDescription
onWord [d3]
endDefinitionDescription
endDefinitionList
beginParagraph
onWord [after]
endParagraph
endDocument
