.#-----------------------------------------------------
.inputexpect|markdown/1.2
.# The Markdown generated for consecutive Groups containing only a code macro in list items (see code15.test) is read
.# back as distinct code macros, and rendered back the same way.
.#-----------------------------------------------------
* item

  <div>

  {{code}}
  a
  {{/code}}

  </div>

  <div>

  {{code}}
  b
  {{/code}}

  </div>
* item

  <div>

  ```
  c
  ```

  </div>

  <div>

  ```java
  d
  ```

  </div>
.#-----------------------------------------------------
.expect|event/1.0
.#-----------------------------------------------------
beginDocument
beginList [BULLETED]
beginListItem
onWord [item]
beginGroup
onMacroStandalone [code] [] [a]
endGroup
beginGroup
onMacroStandalone [code] [] [b]
endGroup
endListItem
beginListItem
onWord [item]
beginGroup
onMacroStandalone [code] [language=none] [c]
endGroup
beginGroup
onMacroStandalone [code] [language=java] [d]
endGroup
endListItem
endList [BULLETED]
endDocument
