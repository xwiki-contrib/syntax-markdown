.#-----------------------------------------------------
.inputexpect|markdown/1.2
.# Verify that inline HTML void elements don't swallow the rest of the paragraph, which is still parsed as Markdown.
.#-----------------------------------------------------
a <br> [[Page]] ~~s~~ b <img src="x.png"> **c**
.#-----------------------------------------------------
.expect|event/1.0
.#-----------------------------------------------------
beginDocument
beginParagraph
onWord [a]
onSpace
onMacroInline [html] [clean=false] [<br>]
onSpace
beginLink [Typed = [false] Type = [doc] Reference = [Page]] [false]
endLink [Typed = [false] Type = [doc] Reference = [Page]] [false]
onSpace
beginFormat [STRIKEDOUT]
onWord [s]
endFormat [STRIKEDOUT]
onSpace
onWord [b]
onSpace
onMacroInline [html] [clean=false] [<img src="x.png">]
onSpace
beginFormat [BOLD]
onWord [c]
endFormat [BOLD]
endParagraph
endDocument
