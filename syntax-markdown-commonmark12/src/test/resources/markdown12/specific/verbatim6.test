.#-----------------------------------------------------
.input|markdown/1.2
.# The verbatim macro syntax generated for verbatim located in headings, list items, quotations and table cells
.# (see verbatim5.test) is read back as verbatim with the same content.
.#-----------------------------------------------------
# Heading ``a`b``

* item {{verbatim}}x*y{{/verbatim}}
    * nested {{verbatim}}multi line{{/verbatim}}

>  quote {{verbatim}}[[not a link]]{{/verbatim}}

| head {{verbatim}}a|b{{/verbatim}} |                    head2                     |
| --------------------------------- | -------------------------------------------- |
| cell {{verbatim}}c|d{{/verbatim}} | {{verbatim}}block in table cell{{/verbatim}} |

* <div>

  {{verbatim}}
  block in list
  {{/verbatim}}

  </div>
.#-----------------------------------------------------
.expect|event/1.0
.#-----------------------------------------------------
beginDocument
beginSection
beginHeader [1, HHeading]
onWord [Heading]
onSpace
onMacroInline [code] [language=none] [a`b]
endHeader [1, HHeading]
beginList [BULLETED]
beginListItem
onWord [item]
onSpace
onVerbatim [x*y] [true]
beginList [BULLETED]
beginListItem
onWord [nested]
onSpace
onVerbatim [multi line] [true]
endListItem
endList [BULLETED]
endListItem
endList [BULLETED]
beginQuotation
beginQuotationLine
onWord [quote]
onSpace
onVerbatim [[[not a link]]] [true]
endQuotationLine
endQuotation
beginTable
beginTableRow
beginTableHeadCell
onWord [head]
onSpace
onVerbatim [a|b] [true]
endTableHeadCell
beginTableHeadCell
onWord [head2]
endTableHeadCell
endTableRow
beginTableRow
beginTableCell
onWord [cell]
onSpace
onVerbatim [c|d] [true]
endTableCell
beginTableCell
onVerbatim [block in table cell] [true]
endTableCell
endTableRow
endTable
beginList [BULLETED]
beginListItem
beginGroup
onVerbatim [
block in list
] [false]
endGroup
endListItem
endList [BULLETED]
endSection
endDocument
