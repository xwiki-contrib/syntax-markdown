.#-----------------------------------------------------
.inputexpect|markdown/1.2
.# The verbatim macro syntax generated for inline verbatim (see verbatim1.test) is read back as inline verbatim with
.# the same content (not as a macro), and the code span generated for a content containing a backtick is read back
.# as an inline code macro with the same content.
.#-----------------------------------------------------
a {{verbatim}}x|y{{/verbatim}} b {{verbatim}}**not bold**{{/verbatim}} c ``a`b`` d {{verbatim}}`a``b`{{/verbatim}} e {{verbatim}} f {{/verbatim}} g {{verbatim}}{{/verbatim}} h {{verbatim}} {{/verbatim}} i
.#-----------------------------------------------------
.expect|event/1.0
.#-----------------------------------------------------
beginDocument
beginParagraph
onWord [a]
onSpace
onVerbatim [x|y] [true]
onSpace
onWord [b]
onSpace
onVerbatim [**not bold**] [true]
onSpace
onWord [c]
onSpace
onMacroInline [code] [language=none] [a`b]
onSpace
onWord [d]
onSpace
onVerbatim [`a``b`] [true]
onSpace
onWord [e]
onSpace
onVerbatim [ f ] [true]
onSpace
onWord [g]
onSpace
onVerbatim [] [true]
onSpace
onWord [h]
onSpace
onVerbatim [ ] [true]
onSpace
onWord [i]
endParagraph
endDocument
